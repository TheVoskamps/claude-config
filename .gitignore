# Invert: .gitignore everything, so invert what we want to NOT .gitignore
/*

# Standard Repo Files
!.gitignore
!.github/
!.github/**
!/LICENSE
!/PATENTS
!/PRIOR_ART.md
!/README.md
!/.markdownlint.jsonc
# Static informational file; tracked like any other source file.
!/CONTRIBUTORS
# On-demand rules files under docs/rules/, plus this repo's own
# per-repo style-guide extensions under docs/rules/extensions/ at the
# fixed names docs/rules/code-style.md defines (today, code-style.md
# alone). Not under .claude/rules/, which is auto-loaded recursively
# and would make an on-demand guide always-on.
!/docs/

# Claude config — whitelist shareable files, ignore everything else.
# New Claude-generated dirs (cache, sessions, projects, todos, ...) stay
# ignored by default. Add them to the allow-list explicitly if needed.
# Re-including a file inside an ignored dir requires un-ignoring each
# parent first (git's negation rule).
!/agents/
!/hooks/
!/output-styles/
!/plans/
!/rules/
!/skills/
!/CLAUDE.md
!/settings.json
!/keybindings.json

# Self-contained installer that lands this repo onto ~/.claude.
!/install.sh

# Installs/updates the Claude Code plugins and marketplaces declared in
# a settings.json (companion to install.sh).
!/plugins.sh

# The *nested* .claude/ (this repo's root IS ~/.claude, so .claude/
# here is the per-repo config for using ~/.claude on itself). Each
# parent must be un-ignored before a file inside becomes visible to
# git.
!/.claude/
!/.claude/rules/

# Per-repo config the thevoskamps/issues plugin reads.
!/.issues/
!/.issues/repo-config.md
!/.issues/.markdownlint.jsonc
# The repo-level user-config the thevoskamps/issues plugin reads holds
# private values and must never be tracked. Re-ignore it AFTER the
# !/.issues/ un-ignore above — gitignore is last-match-wins — so it
# stays ignored even though its sibling repo-config.md is tracked.
/.issues/user-config.md

# Subagent memory entries. Ignoring them keeps a worktree removable
# with plain `git worktree remove`, and enforces the never-staged
# invariant structurally.
/.claude/agent-memory/

# Always ignore local/temp/backup/lock files anywhere under .claude/,
# even inside whitelisted directories
/**/*.local.*
/**/*.backup.*
/**/*.lock
/**/tmp/
/**/worktrees/

# Repo-root CLAUDE override files (sibling to CLAUDE.md)
/CLAUDE.local.*

# Backup files from Claude setup
*.backup.*

#
# Below this should be excluded, but it is belt-and-braces
#

# macOS Finder metadata and temp dirs
.DS_Store
__MACOSX/

# macOS system files
.AppleDouble
.LSOverride
Icon
._*

# Git repo metadata
.git/

# Misc
*.log
*.tmp

#VSCode swapfile
*.swp

